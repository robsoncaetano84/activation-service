{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.productCode == 'PRODUTO-INVALIDO')]" }
        ]
      },
      "response": {
        "status": 422,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "message": "Produto não pode ser ativado para este cliente"
        }
      }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.productCode == 'PRODUTO-INSTAVEL')]" }
        ]
      },
      "response": {
        "status": 503,
        "headers": { "Retry-After": "10" }
      }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [
          { "matchesJsonPath": "$[?(@.productCode == 'PRODUTO-LENTO')]" }
        ]
      },
      "response": {
        "status": 200,
        "fixedDelayMilliseconds": 8000
      }
    },
    {
      "priority": 10,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate"
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "status": "ACTIVATED" }
      }
    }
  ]
}
